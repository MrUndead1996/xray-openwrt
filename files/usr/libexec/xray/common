#!/bin/sh

xray_log() {
    tag=$1
    shift
    logger -t "xray-$tag" -- "$*"
}

xray_die() {
    tag=$1
    shift
    xray_log "$tag" "$*"
    return 1
}

xray_lock_pid_dead() {
    pid=$1
    proc_root=${XRAY_PROC_ROOT:-/proc}

    "${XRAY_KILL:-kill}" -0 "$pid" 2>/dev/null && return 1
    [ -d "$proc_root" ] && [ -r "$proc_root" ] && [ -x "$proc_root" ] || return 1
    [ -e "$proc_root/$pid" ] && return 1
    return 0
}

xray_lock_acquire() {
    name=$1
    lock_root=${XRAY_LOCK_ROOT:-/var/lock}
    lock_dir="$lock_root/$name"
    pid_file="$lock_dir/pid"
    reclaim_dir="$lock_dir.reclaim"
    stale_dir="$reclaim_dir/$name"

    mkdir -p "$lock_root" || return 1

    if mkdir "$lock_dir" 2>/dev/null; then
        printf '%s\n' "$$" > "$pid_file" || {
            rmdir "$lock_dir"
            return 1
        }
        return 0
    fi

    mkdir "$reclaim_dir" 2>/dev/null || {
        xray_log lock "busy lock: $name"
        return 1
    }

    if [ -r "$pid_file" ]; then
        pid=$(cat "$pid_file" 2>/dev/null) || pid=
    else
        pid=
    fi

    case $pid in
        ''|*[!0-9]*)
            rmdir "$reclaim_dir"
            xray_log lock "busy lock: $name"
            return 1
            ;;
    esac

    if ! xray_lock_pid_dead "$pid"; then
        rmdir "$reclaim_dir"
        xray_log lock "busy lock: $name"
        return 1
    fi

    if ! mv "$lock_dir" "$reclaim_dir" || ! mkdir "$lock_dir" || \
        ! printf '%s\n' "$$" > "$pid_file"; then
        rm -f "$stale_dir/pid"
        rmdir "$stale_dir" 2>/dev/null || :
        rmdir "$reclaim_dir" 2>/dev/null || :
        return 1
    fi

    rm -f "$stale_dir/pid"
    rmdir "$stale_dir" 2>/dev/null || :
    rmdir "$reclaim_dir" 2>/dev/null || :
    return 0
}

xray_lock_release() {
    name=$1
    lock_root=${XRAY_LOCK_ROOT:-/var/lock}
    lock_dir="$lock_root/$name"
    pid_file="$lock_dir/pid"

    [ -r "$pid_file" ] || return 0
    [ "$(cat "$pid_file" 2>/dev/null)" = "$$" ] || return 0

    rm -f "$pid_file" && rmdir "$lock_dir"
}

xray_atomic_install() {
    source_file=$1
    destination=$2
    mode=$3
    owner=$4
    group=$5
    temporary="$destination.new.$$"

    rm -f "$temporary"
    if ! cp "$source_file" "$temporary" || \
        ! chmod "$mode" "$temporary" || \
        ! chown "$owner:$group" "$temporary" || \
        ! mv "$temporary" "$destination"; then
        rm -f "$temporary"
        return 1
    fi
}

xray_service_running() {
    "${XRAY_INIT_SCRIPT:-/etc/init.d/xray}" running
}
