#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10
EXTRA_COMMANDS="restart_runtime stop_runtime"
EXTRA_HELP="\
\trestart_runtime\tRestart Xray without changing TProxy\n\
\tstop_runtime\tStop Xray without changing TProxy"

XRAY_CONFIG_PACKAGE=xray
XRAY_BINARY=${XRAY_BINARY:-/usr/bin/xray}
XRAY_CONFIG=${XRAY_CONFIG:-/etc/xray/config.json}
XRAY_ASSETS=${XRAY_ASSETS:-/usr/share/xray}
XRAY_CA_CERT=${XRAY_CA_CERT:-/etc/ssl/certs/ca-certificates.crt}
XRAY_TPROXY_HELPER=${XRAY_TPROXY_HELPER:-/usr/libexec/xray/tproxy}

. "${XRAY_FUNCTIONS_PATH:-/lib/functions.sh}"
. "${XRAY_PROCD_PATH:-/lib/functions/procd.sh}"

xray_error() {
    logger -t xray "$*"
    printf '%s\n' "$*" >&2
}

xray_enabled() {
    local enabled

    config_load "$XRAY_CONFIG_PACKAGE"
    config_get enabled main enabled 0
    [ "$enabled" = 1 ]
}

xray_validate() {
    if [ ! -x "$XRAY_BINARY" ]; then
        xray_error "Xray executable not found: $XRAY_BINARY"
        return 1
    fi

    if [ ! -f "$XRAY_CONFIG" ]; then
        xray_error "Xray configuration not found: $XRAY_CONFIG"
        return 1
    fi

    "$XRAY_BINARY" run -test -config "$XRAY_CONFIG" -format json
}

start_runtime() {
    xray_validate || return 1
    start_runtime_validated
}

start_runtime_validated() {
    procd_open_instance xray || return 1
    procd_set_param command "$XRAY_BINARY" run -config "$XRAY_CONFIG" -format json
    procd_set_param env "XRAY_LOCATION_ASSET=$XRAY_ASSETS"
    procd_set_param file "$XRAY_CONFIG"
    procd_add_jail xray procfs log
    procd_add_jail_mount "$XRAY_CONFIG"
    procd_add_jail_mount "$XRAY_ASSETS"
    procd_add_jail_mount "$XRAY_CA_CERT"
    procd_set_param user xray
    procd_set_param capabilities /etc/capabilities/xray.json
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn
    procd_close_instance
}

stop_runtime() {
    procd_kill xray
}

restart_runtime() {
    xray_validate || return 1
    stop_runtime
    start_runtime_validated
}

start_service() {
    local runtime_was_running=0

    xray_enabled || return 0
    xray_validate || return 1
    procd_running xray && runtime_was_running=1

    if ! "$XRAY_TPROXY_HELPER" start; then
        [ "$runtime_was_running" -eq 1 ] || "$XRAY_TPROXY_HELPER" stop
        return 1
    fi
    if ! start_runtime_validated; then
        [ "$runtime_was_running" -eq 1 ] || "$XRAY_TPROXY_HELPER" stop
        return 1
    fi
}

stop_service() {
    stop_runtime
    "$XRAY_TPROXY_HELPER" stop
}

reload_service() {
    if ! xray_enabled; then
        stop_service
        return 0
    fi

    restart_runtime
}

service_triggers() {
    procd_add_reload_trigger "$XRAY_CONFIG_PACKAGE"
}
