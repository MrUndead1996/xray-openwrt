table inet xray {
    set private_ipv4 {
        type ipv4_addr
        flags interval
        auto-merge
        elements = {
            0.0.0.0/32,
            10.0.0.0/8,
            100.64.0.0/10,
            127.0.0.0/8,
            169.254.0.0/16,
            172.16.0.0/12,
            192.0.0.0/24,
            192.0.2.0/24,
            192.88.99.0/24,
            192.168.0.0/16,
            198.18.0.0/15,
            198.51.100.0/24,
            203.0.113.0/24,
            224.0.0.0/4,
            240.0.0.0/4
        }
    }

    set bypass_cidr {
        type ipv4_addr
        flags interval
        auto-merge
        @BYPASS_ELEMENTS@
    }

    set interface {
        type ipv4_addr
        flags interval
        auto-merge
    }

    chain tp_out {
        meta mark & @BYPASS_MARK@ == @BYPASS_MARK@ return

        meta l4proto { tcp, udp } fib saddr type local fib daddr type != local jump tp_rule
    }

    chain tp_pre {
        iifname "lo" mark & @MASK@ != @MARK@ return

        meta l4proto { tcp, udp } fib saddr type != local fib daddr type != local jump tp_rule
        meta l4proto { tcp, udp } mark & @MASK@ == @MARK@ tproxy ip to 127.0.0.1:@PORT@
    }

    chain output {
        type route hook output priority mangle - 5; policy accept;
        meta nfproto ipv4 jump tp_out
    }

    chain prerouting {
        type filter hook prerouting priority mangle - 5; policy accept;
        meta nfproto ipv4 jump tp_pre
    }

    chain tp_rule {
        meta mark set ct mark
        meta mark & @MASK@ == @MARK@ return
        skgid @GID@ return

        iifname "docker*" return
        iifname "veth*" return
        iifname "wg*" return
        iifname "ppp*" return

        ip daddr @interface return
        ip daddr @private_ipv4 return
        ip daddr @bypass_cidr return
        jump tp_mark
    }

    chain tp_mark {
        tcp flags & (fin | syn | rst | ack) == syn meta mark set mark | @MARK@
        meta l4proto udp ct state new meta mark set mark | @MARK@
        ct mark set mark
    }
}
